        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a221"
                TIME_SLOT_REF1="ts442" TIME_SLOT_REF2="ts443">
                <ANNOTATION_VALUE>to speak with us tonight.</ANNOTATION_VALUE>
