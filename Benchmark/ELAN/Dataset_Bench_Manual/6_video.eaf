            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a333"
                TIME_SLOT_REF1="ts101" TIME_SLOT_REF2="ts104">
                <ANNOTATION_VALUE>You didn't have a mom. Your mom passed away when you were so young.</ANNOTATION_VALUE>
