        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a344"
                TIME_SLOT_REF1="ts285" TIME_SLOT_REF2="ts289">
                <ANNOTATION_VALUE>But you are helping me. That's what I want you to always see. Like, I'm so lonely. I'm so sad. I'm calling you crying, but I'm calling you. Because literally, just your presence and your ability to just listen to me and to just be, not fix it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a417"
                TIME_SLOT_REF1="ts292" TIME_SLOT_REF2="ts293">
                <ANNOTATION_VALUE>Yeah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a418"
                TIME_SLOT_REF1="ts294" TIME_SLOT_REF2="ts295">
                <ANNOTATION_VALUE>You stress me out, yeah.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a419"
                TIME_SLOT_REF1="ts296" TIME_SLOT_REF2="ts297">
                <ANNOTATION_VALUE>Yeah. [laugh]</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a345"
                TIME_SLOT_REF1="ts298" TIME_SLOT_REF2="ts306">
                <ANNOTATION_VALUE>Yeah. I don't need you to be a fixer. I need you to just be support. I need you to be an ear. I just need your heart, your energy, the warmth you have as being my mom.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
