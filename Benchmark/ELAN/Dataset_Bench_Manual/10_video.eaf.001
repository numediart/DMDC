        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a331"
                TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts14">
                <ANNOTATION_VALUE>Like I'm not the easiest person to laugh, but like the fact that it's like you're fixing</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a332"
                TIME_SLOT_REF1="ts15" TIME_SLOT_REF2="ts30">
                <ANNOTATION_VALUE>nature's like, like fuck you in the secret lounge and like, you know, when you think</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a333"
                TIME_SLOT_REF1="ts31" TIME_SLOT_REF2="ts41">
                <ANNOTATION_VALUE>of the first time we met, what do you remember feeling?</ANNOTATION_VALUE>
