        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a15"
                TIME_SLOT_REF1="ts195" TIME_SLOT_REF2="ts211">
                <ANNOTATION_VALUE>The first time we. I've told you this: the first time we met, I thought I was quite intimidated by you.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
