        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a265"
                TIME_SLOT_REF1="ts517" TIME_SLOT_REF2="ts520">
                <ANNOTATION_VALUE>should they check out on your channel?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a275"
                TIME_SLOT_REF1="ts543" TIME_SLOT_REF2="ts544">
                <ANNOTATION_VALUE>Thanks for being with us, Lisa, today.</ANNOTATION_VALUE>
