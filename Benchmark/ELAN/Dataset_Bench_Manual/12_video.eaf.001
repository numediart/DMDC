        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a176"
                TIME_SLOT_REF1="ts168" TIME_SLOT_REF2="ts169">
                <ANNOTATION_VALUE>what you're talking about or do this mental gymnastics</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177"
                TIME_SLOT_REF1="ts170" TIME_SLOT_REF2="ts171">
                <ANNOTATION_VALUE>to figure out where this story is coming into play,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a178"
                TIME_SLOT_REF1="ts172" TIME_SLOT_REF2="ts173">
                <ANNOTATION_VALUE>they're not gonna do it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a179"
                TIME_SLOT_REF1="ts174" TIME_SLOT_REF2="ts175">
                <ANNOTATION_VALUE>They're gonna check out.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a180"
                TIME_SLOT_REF1="ts176" TIME_SLOT_REF2="ts177">
                <ANNOTATION_VALUE>And so one way to check yourself on it is,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a181"
                TIME_SLOT_REF1="ts178" TIME_SLOT_REF2="ts179">
                <ANNOTATION_VALUE>can you articulate very quickly and very succinctly</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a182"
                TIME_SLOT_REF1="ts180" TIME_SLOT_REF2="ts183">
                <ANNOTATION_VALUE>what the point of your story is?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a183"
                TIME_SLOT_REF1="ts184" TIME_SLOT_REF2="ts187">
                <ANNOTATION_VALUE>- Yeah. - If you can,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a184"
                TIME_SLOT_REF1="ts188" TIME_SLOT_REF2="ts189">
                <ANNOTATION_VALUE>you're probably on the right track.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a185"
                TIME_SLOT_REF1="ts190" TIME_SLOT_REF2="ts195">
                <ANNOTATION_VALUE>If you can't, you probably wanna pick another one.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186"
                TIME_SLOT_REF1="ts196" TIME_SLOT_REF2="ts197">
                <ANNOTATION_VALUE>- That's a great place to start</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a187"
                TIME_SLOT_REF1="ts198" TIME_SLOT_REF2="ts199">
                <ANNOTATION_VALUE>because I know exactly what you mean.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a188"
                TIME_SLOT_REF1="ts200" TIME_SLOT_REF2="ts201">
                <ANNOTATION_VALUE>Yes, I go to church.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189"
                TIME_SLOT_REF1="ts202" TIME_SLOT_REF2="ts203">
                <ANNOTATION_VALUE>Yes, I've seen guest speakers</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190"
                TIME_SLOT_REF1="ts204" TIME_SLOT_REF2="ts205">
                <ANNOTATION_VALUE>and everybody's holding their breath.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a191"
                TIME_SLOT_REF1="ts206" TIME_SLOT_REF2="ts207">
                <ANNOTATION_VALUE>Are they gonna go on some long tangent</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a192"
                TIME_SLOT_REF1="ts208" TIME_SLOT_REF2="ts209">
                <ANNOTATION_VALUE>or are they gonna make a point?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a193"
                TIME_SLOT_REF1="ts210" TIME_SLOT_REF2="ts211">
                <ANNOTATION_VALUE>And I think sometimes we tell stories</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a194"
                TIME_SLOT_REF1="ts212" TIME_SLOT_REF2="ts213">
                <ANNOTATION_VALUE>for the pure entertainment value of it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195"
                TIME_SLOT_REF1="ts214" TIME_SLOT_REF2="ts215">
                <ANNOTATION_VALUE>But if there's no point behind it for our listeners,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a196"
                TIME_SLOT_REF1="ts216" TIME_SLOT_REF2="ts217">
                <ANNOTATION_VALUE>if we don't know why we're communicating this message,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a197"
                TIME_SLOT_REF1="ts218" TIME_SLOT_REF2="ts219">
                <ANNOTATION_VALUE>it can really miss the mark.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198"
                TIME_SLOT_REF1="ts220" TIME_SLOT_REF2="ts221">
                <ANNOTATION_VALUE>And so I think that's a great place to start.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a199"
                TIME_SLOT_REF1="ts222" TIME_SLOT_REF2="ts223">
                <ANNOTATION_VALUE>You have to know that point that you're driving at</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200"
                TIME_SLOT_REF1="ts224" TIME_SLOT_REF2="ts225">
                <ANNOTATION_VALUE>and that becomes the focus of everything you say</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a201"
                TIME_SLOT_REF1="ts226" TIME_SLOT_REF2="ts227">
                <ANNOTATION_VALUE>and a good way to make decisions</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a202"
                TIME_SLOT_REF1="ts228" TIME_SLOT_REF2="ts229">
                <ANNOTATION_VALUE>about what to include and what to leave out.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a203"
                TIME_SLOT_REF1="ts230" TIME_SLOT_REF2="ts235">
                <ANNOTATION_VALUE>What's your second tip?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a204"
                TIME_SLOT_REF1="ts236" TIME_SLOT_REF2="ts241">
                <ANNOTATION_VALUE>- Sure, my second tip is all about</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a205"
                TIME_SLOT_REF1="ts242" TIME_SLOT_REF2="ts243">
                <ANNOTATION_VALUE>tailoring your content to your audiences,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a206"
                TIME_SLOT_REF1="ts244" TIME_SLOT_REF2="ts247">
                <ANNOTATION_VALUE>either their problem or their pursuit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a207"
                TIME_SLOT_REF1="ts248" TIME_SLOT_REF2="ts251">
                <ANNOTATION_VALUE>So a lot of times we wanna know,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a208"
                TIME_SLOT_REF1="ts252" TIME_SLOT_REF2="ts253">
                <ANNOTATION_VALUE>well, what story should I tell?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a209"
                TIME_SLOT_REF1="ts254" TIME_SLOT_REF2="ts255">
                <ANNOTATION_VALUE>What should I be talking about?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a210"
                TIME_SLOT_REF1="ts256" TIME_SLOT_REF2="ts257">
                <ANNOTATION_VALUE>Well, you need to start thinking outward,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a211"
                TIME_SLOT_REF1="ts258" TIME_SLOT_REF2="ts259">
                <ANNOTATION_VALUE>not so much about you, but who are you talking to?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a212"
                TIME_SLOT_REF1="ts260" TIME_SLOT_REF2="ts261">
                <ANNOTATION_VALUE>And who is your audience?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a213"
                TIME_SLOT_REF1="ts262" TIME_SLOT_REF2="ts263">
                <ANNOTATION_VALUE>So once I start thinking along those lines,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a214"
                TIME_SLOT_REF1="ts264" TIME_SLOT_REF2="ts265">
                <ANNOTATION_VALUE>it's like, okay, well,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a215"
                TIME_SLOT_REF1="ts266" TIME_SLOT_REF2="ts267">
                <ANNOTATION_VALUE>what problems is my audience having, right?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
