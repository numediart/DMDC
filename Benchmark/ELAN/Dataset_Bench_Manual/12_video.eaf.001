        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a147"
                TIME_SLOT_REF1="ts106" TIME_SLOT_REF2="ts107">
                <ANNOTATION_VALUE>So we've got this guest preacher</ANNOTATION_VALUE>
