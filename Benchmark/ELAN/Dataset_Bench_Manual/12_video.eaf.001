        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a295"
                TIME_SLOT_REF1="ts444" TIME_SLOT_REF2="ts445">
                <ANNOTATION_VALUE>And so we wanna be very judicious in terms</ANNOTATION_VALUE>
