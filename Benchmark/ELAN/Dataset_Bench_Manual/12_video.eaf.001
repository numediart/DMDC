        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a148"
                TIME_SLOT_REF1="ts108" TIME_SLOT_REF2="ts111">
                <ANNOTATION_VALUE>and he gets to telling a story about a fish.</ANNOTATION_VALUE>
