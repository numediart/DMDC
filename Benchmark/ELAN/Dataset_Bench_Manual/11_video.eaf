        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a978"
                TIME_SLOT_REF1="ts46" TIME_SLOT_REF2="ts47">
                <ANNOTATION_VALUE>like, reading together.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a979"
                TIME_SLOT_REF1="ts50" TIME_SLOT_REF2="ts51">
                <ANNOTATION_VALUE>You know? Like we, we read together and,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a981"
                TIME_SLOT_REF1="ts52" TIME_SLOT_REF2="ts53">
                <ANNOTATION_VALUE>and the way that I feel like I was there when you were discovering like how to write.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a982"
                TIME_SLOT_REF1="ts54" TIME_SLOT_REF2="ts55">
                <ANNOTATION_VALUE>You know? Like you almost... I was witnessing you learning how to find your own voice and what you were writing was crazy. I remember feeling like, what is happening? Like, this kid can write, like he's writing stuff.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a983"
                TIME_SLOT_REF1="ts56" TIME_SLOT_REF2="ts58">
                <ANNOTATION_VALUE>But what did you remember? Like you remembered right away.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a984"
                TIME_SLOT_REF1="ts59" TIME_SLOT_REF2="ts61">
                <ANNOTATION_VALUE>What is it?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
