        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a967"
                TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts28">
                <ANNOTATION_VALUE>My favorite part was to fill the water bottle. That was it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a971"
                TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts33">
                <ANNOTATION_VALUE>What experience best illustrates our connection and why?</ANNOTATION_VALUE>
