        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a752"
                TIME_SLOT_REF1="ts952" TIME_SLOT_REF2="ts958">
                <ANNOTATION_VALUE>I'd like to say manifested you, but that's fine. I think this is all down to me.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a753"
                TIME_SLOT_REF1="ts962" TIME_SLOT_REF2="ts968">
                <ANNOTATION_VALUE>But it's it, like I I literally you turn I you were everything that I internally manifested in someone and it happened at the perfect time.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a754"
                TIME_SLOT_REF1="ts970" TIME_SLOT_REF2="ts975">
                <ANNOTATION_VALUE>And I'm so thankful for me too.</ANNOTATION_VALUE>
