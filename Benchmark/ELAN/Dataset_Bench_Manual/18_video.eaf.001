            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102"
                TIME_SLOT_REF1="ts106" TIME_SLOT_REF2="ts107">
                <ANNOTATION_VALUE>that's in front of us.</ANNOTATION_VALUE>
