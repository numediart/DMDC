            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a171"
                TIME_SLOT_REF1="ts258" TIME_SLOT_REF2="ts259">
                <ANNOTATION_VALUE>So that example, of one of my clients</ANNOTATION_VALUE>
