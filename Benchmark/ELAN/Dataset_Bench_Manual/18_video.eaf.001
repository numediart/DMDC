        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166"
                TIME_SLOT_REF1="ts248" TIME_SLOT_REF2="ts249">
                <ANNOTATION_VALUE>"Why do I feel this way?</ANNOTATION_VALUE>
