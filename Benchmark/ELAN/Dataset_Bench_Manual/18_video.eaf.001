        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111"
                TIME_SLOT_REF1="ts124" TIME_SLOT_REF2="ts125">
                <ANNOTATION_VALUE>the question is, "Why does the emotion keep on coming back?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112"
                TIME_SLOT_REF1="ts126" TIME_SLOT_REF2="ts127">
                <ANNOTATION_VALUE>In our case, the nerves or the anxiety?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113"
                TIME_SLOT_REF1="ts128" TIME_SLOT_REF2="ts129">
                <ANNOTATION_VALUE>It's because we are thinking of the same thing such as,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114"
                TIME_SLOT_REF1="ts130" TIME_SLOT_REF2="ts131">
                <ANNOTATION_VALUE>"Oh, my voice is trembling again.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115"
                TIME_SLOT_REF1="ts132" TIME_SLOT_REF2="ts133">
                <ANNOTATION_VALUE>I'm such a bad speaker, I'm nervous."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116"
                TIME_SLOT_REF1="ts134" TIME_SLOT_REF2="ts135">
                <ANNOTATION_VALUE>"So have you ever spoke before?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117"
                TIME_SLOT_REF1="ts136" TIME_SLOT_REF2="ts137">
                <ANNOTATION_VALUE>Many people say this,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118"
                TIME_SLOT_REF1="ts138" TIME_SLOT_REF2="ts139">
                <ANNOTATION_VALUE>and I asked them, "Do you get nervous?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119"
                TIME_SLOT_REF1="ts140" TIME_SLOT_REF2="ts141">
                <ANNOTATION_VALUE>Kind of like when you get in a minute, two minute,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120"
                TIME_SLOT_REF1="ts142" TIME_SLOT_REF2="ts143">
                <ANNOTATION_VALUE>three minutes in after you talk?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121"
                TIME_SLOT_REF1="ts144" TIME_SLOT_REF2="ts145">
                <ANNOTATION_VALUE>And most people say,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122"
                TIME_SLOT_REF1="ts146" TIME_SLOT_REF2="ts147">
                <ANNOTATION_VALUE>"No, I get into a rhythm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123"
