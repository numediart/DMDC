        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a155"
                TIME_SLOT_REF1="ts226" TIME_SLOT_REF2="ts227">
                <ANNOTATION_VALUE>But there's usually a deeper thought,</ANNOTATION_VALUE>
