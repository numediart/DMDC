        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139"
                TIME_SLOT_REF1="ts184" TIME_SLOT_REF2="ts185">
                <ANNOTATION_VALUE>of what's making us tick inside?</ANNOTATION_VALUE>
