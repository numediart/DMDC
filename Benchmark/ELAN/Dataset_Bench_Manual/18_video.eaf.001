        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104"
                TIME_SLOT_REF1="ts110" TIME_SLOT_REF2="ts111">
                <ANNOTATION_VALUE>I just wanna give a quick reasoning into that.</ANNOTATION_VALUE>
