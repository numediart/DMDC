        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a563"
                TIME_SLOT_REF1="ts460" TIME_SLOT_REF2="ts463">
                <ANNOTATION_VALUE>And I can't believe here we are</ANNOTATION_VALUE>
