        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1"
                TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts6">
                <ANNOTATION_VALUE>[music] If this were to be our last conversation ever, what would you want me to never forget and why?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a520"
                TIME_SLOT_REF1="ts7" TIME_SLOT_REF2="ts16">
                <ANNOTATION_VALUE>[music]</ANNOTATION_VALUE>
