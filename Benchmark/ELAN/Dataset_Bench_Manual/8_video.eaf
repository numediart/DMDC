        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a497"
                TIME_SLOT_REF1="ts473" TIME_SLOT_REF2="ts475">
                <ANNOTATION_VALUE>I hope they'll see that, um</ANNOTATION_VALUE>
