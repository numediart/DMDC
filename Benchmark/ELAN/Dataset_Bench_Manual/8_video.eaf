        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a505"
                TIME_SLOT_REF1="ts517" TIME_SLOT_REF2="ts520">
                <ANNOTATION_VALUE>Yeah, how much love matters. [yeah]</ANNOTATION_VALUE>
