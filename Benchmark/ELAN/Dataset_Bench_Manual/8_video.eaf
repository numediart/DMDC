            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a510"
                TIME_SLOT_REF1="ts561" TIME_SLOT_REF2="ts563">
                <ANNOTATION_VALUE>Well, your love feels</ANNOTATION_VALUE>
