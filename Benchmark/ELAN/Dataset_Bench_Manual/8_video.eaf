        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a511"
                TIME_SLOT_REF1="ts565" TIME_SLOT_REF2="ts567">
                <ANNOTATION_VALUE>You make me feel like I'm capable of anything.</ANNOTATION_VALUE>
