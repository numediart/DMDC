        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a574"
                TIME_SLOT_REF1="ts102" TIME_SLOT_REF2="ts104">
                <ANNOTATION_VALUE>There you go, that's the sound.</ANNOTATION_VALUE>
