        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a561"
                TIME_SLOT_REF1="ts18" TIME_SLOT_REF2="ts19">
                <ANNOTATION_VALUE>Because our life is fucking nuts.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
