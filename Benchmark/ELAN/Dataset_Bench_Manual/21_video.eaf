        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a562"
                TIME_SLOT_REF1="ts20" TIME_SLOT_REF2="ts21">
                <ANNOTATION_VALUE>and, um, we are in constant motion.</ANNOTATION_VALUE>
