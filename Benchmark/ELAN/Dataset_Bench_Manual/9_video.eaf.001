            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a769"
                TIME_SLOT_REF1="ts344" TIME_SLOT_REF2="ts346">
                <ANNOTATION_VALUE>So there was a whole range of new fears for me.</ANNOTATION_VALUE>
