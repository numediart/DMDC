        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a770"
                TIME_SLOT_REF1="ts348" TIME_SLOT_REF2="ts352">
                <ANNOTATION_VALUE>That replaced the old fears, which were things around, you know, rejection and being made to feel.</ANNOTATION_VALUE>
