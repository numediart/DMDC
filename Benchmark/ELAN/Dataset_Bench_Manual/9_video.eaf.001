        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a766"
                TIME_SLOT_REF1="ts269" TIME_SLOT_REF2="ts272">
                <ANNOTATION_VALUE>When we started our relationship, what were your biggest fears or concerns and why?</ANNOTATION_VALUE>
