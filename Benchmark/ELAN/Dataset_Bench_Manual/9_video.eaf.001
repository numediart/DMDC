        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a776"
                TIME_SLOT_REF1="ts392" TIME_SLOT_REF2="ts394">
                <ANNOTATION_VALUE>with HIV carry, because we carry the we carry the brunt of responsibility.</ANNOTATION_VALUE>
