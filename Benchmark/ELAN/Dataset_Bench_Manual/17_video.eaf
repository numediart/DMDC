        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a567"
                TIME_SLOT_REF1="ts752" TIME_SLOT_REF2="ts755">
                <ANNOTATION_VALUE>I guess the simpler but more meta way of saying is,</ANNOTATION_VALUE>
